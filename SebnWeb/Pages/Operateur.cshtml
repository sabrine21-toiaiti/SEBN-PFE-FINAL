@page
@model SebnWeb.Pages.OperateurModel
@{ ViewData["Title"] = "Espace opérateur"; }

<div class="sebn-header">
    <div>
        <div style="font-size:22px; font-weight:700; color:var(--navy-dark);">Espace opérateur</div>
        <div style="font-size:13px; color:#6b6b70;">Contrôle de votre poste et détection des non-conformités</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="sebn-kpi">
            <h5>Détection qualité</h5>
            <p class="text-muted">Lancez une capture pour contrôler le poste de production.</p>
            <a class="btn btn-sebn" href="/FluxVideo">Ouvrir la détection</a>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="sebn-kpi">
            <h5>Votre rôle</h5>
            <p class="mb-0">Opérateur de Production</p>
        </div>
    </div>
</div>
