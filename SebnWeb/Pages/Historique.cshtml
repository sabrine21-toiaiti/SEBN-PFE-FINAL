@page
@model SebnWeb.Pages.HistoriqueModel
@{ ViewData["Title"] = "Historique"; }

<div class="sebn-header">
    <div>
        <div style="font-size:22px; font-weight:700; color:var(--navy-dark);">Historique des non-conformités</div>
        <div style="font-size:13px; color:#6b6b70;">Recherche, filtrage et clôture des anomalies</div>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select class="form-select" name="TypeFiltre" onchange="this.form.submit()">
            @foreach (var t in new[] { "Tous", "Qualité", "Production", "5S" })
            {
                <option value="@t" selected="@(t == Model.TypeFiltre)">@t</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select" name="StatutFiltre" onchange="this.form.submit()">
            <option value="Tous" selected="@(Model.StatutFiltre=="Tous")">Tous les statuts</option>
            <option value="NON_TRAITEE" selected="@(Model.StatutFiltre=="NON_TRAITEE")">Non traitée</option>
            <option value="CORRIGEE" selected="@(Model.StatutFiltre=="CORRIGEE")">Corrigée</option>
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select" name="PosteFiltre" onchange="this.form.submit()">
            <option value="Tous" selected="@(Model.PosteFiltre=="Tous")">Tous les postes</option>
            @foreach (var p in Model.Postes)
            {
                <option value="@p.IdPoste" selected="@(p.IdPoste==Model.PosteFiltre)">@p.IdPoste</option>
            }
        </select>
    </div>
</form>

<p class="text-muted">@Model.Historique.Count résultat(s)</p>

@if (Model.AnomalieSelectionnee != null)
{
    <div class="sebn-kpi mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Détail de l’anomalie #@Model.AnomalieSelectionnee.IdAnomalie</h5>
            <a class="btn btn-sm btn-outline-secondary" href="@Model.LienHistorique(Model.Page)">Fermer</a>
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-4">Date/heure</dt><dd class="col-sm-8">@Model.AnomalieSelectionnee.DateHeure.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-4">Type d’anomalie</dt><dd class="col-sm-8">@Model.AnomalieSelectionnee.TypeAnomalie</dd>
            <dt class="col-sm-4">Classe YOLO</dt><dd class="col-sm-8"><code>@Model.AnomalieSelectionnee.ClasseYolo</code></dd>
            <dt class="col-sm-4">Confiance</dt><dd class="col-sm-8">@((int)(Model.AnomalieSelectionnee.Confiance * 100))%</dd>
            <dt class="col-sm-4">Poste</dt><dd class="col-sm-8">@Model.AnomalieSelectionnee.IdPoste</dd>
            <dt class="col-sm-4">Matricule opérateur</dt><dd class="col-sm-8">@Model.AnomalieSelectionnee.MatriculeOp</dd>
            <dt class="col-sm-4">Statut</dt><dd class="col-sm-8">@Model.AnomalieSelectionnee.Statut.Libelle()</dd>
            @if (Model.ImagePreuveDisponible)
            {
                <dt class="col-sm-4">Image de preuve</dt>
                <dd class="col-sm-8"><img src="@Model.ImagePreuveUrl" class="img-fluid rounded" alt="Image de preuve" /></dd>
            }
        </dl>
        @if (Model.AnomalieSelectionnee.Statut == StatutAnomalie.NonTraitee && Model.PeutCloturer)
        {
            <form method="post" asp-page-handler="Cloturer" asp-route-id="@Model.AnomalieSelectionnee.IdAnomalie" class="mt-3">
                <input type="hidden" name="TypeFiltre" value="@Model.TypeFiltre" />
                <input type="hidden" name="StatutFiltre" value="@Model.StatutFiltre" />
                <input type="hidden" name="PosteFiltre" value="@Model.PosteFiltre" />
                <input type="hidden" name="pageNumber" value="@Model.Page" />
                <button class="btn btn-outline-success">Clôturer cette anomalie</button>
            </form>
        }
    </div>
}

<div class="sebn-kpi">
    <div class="table-responsive" style="max-height:480px;">
        <table class="table table-sm table-hover">
            <thead>
                <tr><th>ID</th><th>Date/Heure</th><th>Type</th><th>Défaut</th><th>Confiance</th><th>Ligne</th><th>Opérateur</th><th>Statut</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var a in Model.Historique)
            {
                <tr>
                    <td>#@a.IdAnomalie</td>
                    <td>@a.DateHeure.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@a.TypeAnomalie</td>
                    <td>@a.ClasseYolo</td>
                    <td>@((int)(a.Confiance*100))%</td>
                    <td>@Model.LignesPostes.GetValueOrDefault(a.IdPoste, a.IdPoste)</td>
                    <td>@Model.NomsOperateurs.GetValueOrDefault(a.MatriculeOp, a.MatriculeOp)</td>
                    <td>
                        @if (a.Statut == SebnWeb.Models.StatutAnomalie.Corrigee)
                        {
                            <span class="badge badge-success">Corrigée</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Non traitée</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="@Model.LienHistorique(Model.Page, a.IdAnomalie)">Détail</a>
                        @if (a.Statut == SebnWeb.Models.StatutAnomalie.NonTraitee && Model.PeutCloturer)
                        {
                            <form method="post" asp-page-handler="Cloturer" asp-route-id="@a.IdAnomalie">
                                <input type="hidden" name="TypeFiltre" value="@Model.TypeFiltre" />
                                <input type="hidden" name="StatutFiltre" value="@Model.StatutFiltre" />
                                <input type="hidden" name="PosteFiltre" value="@Model.PosteFiltre" />
                                <input type="hidden" name="pageNumber" value="@Model.Page" />
                                <button class="btn btn-sm btn-outline-success">Clôturer</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<nav aria-label="Pagination de l’historique" class="mt-3">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
            <a class="page-link" href="@Model.LienHistorique(1)">Première</a>
        </li>
        <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
            <a class="page-link" href="@Model.LienHistorique(Model.Page - 1)">Précédente</a>
        </li>
        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
        {
            <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                <a class="page-link" href="@Model.LienHistorique(pageNumber)">@pageNumber</a>
            </li>
        }
        <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="@Model.LienHistorique(Model.Page + 1)">Suivante</a>
        </li>
        <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="@Model.LienHistorique(Model.TotalPages)">Dernière</a>
        </li>
    </ul>
</nav>
