@page
@model SebnWeb.Pages.FluxVideoModel
@{ ViewData["Title"] = "Flux vidéo"; }

<div class="sebn-header">
    <div>
        <div style="font-size:22px; font-weight:700; color:var(--navy-dark);">Surveillance en temps réel</div>
        <div style="font-size:13px; color:#6b6b70;">Détection automatique des non-conformités par vision par ordinateur</div>
    </div>
</div>

@if (!Model.ApiDisponible)
{
    <div class="alert alert-warning">
        ⚠️ Le microservice IA (<code>ia-service</code>) n'est pas accessible actuellement.
        Si l'application vient de démarrer (plan gratuit), le service met parfois
        30 à 60 secondes à se réveiller — réessayez dans une minute.
    </div>
}
else if (Model.ModeIA == "reel")
{
    <span class="badge badge-success pulse mb-3">MODE RÉEL — Microservice IA connecté</span>
}
else if (Model.ModeIA == "simulation")
{
    <span class="badge badge-warning pulse mb-3">MODE SIMULATION — connecté au microservice IA</span>
}

<div class="row">
    <div class="col-md-8">
        <div id="posteImageZone" class="sebn-kpi text-center">
            @if (Model.ImageBase64 != null)
            {
                <img src="data:image/png;base64,@Model.ImageBase64" class="img-fluid rounded" />
            }
            else
            {
                <div class="text-muted py-5">Cliquez sur « Capturer une image » pour démarrer.</div>
            }
        </div>
    </div>
    <div class="col-md-4">
        <form method="post" asp-page-handler="Capturer">
            <div class="sebn-kpi mb-3">
                <label class="form-label">Poste surveillé</label>
                <select class="form-select mb-3" asp-for="IdPoste">
                    @foreach (var p in Model.Postes)
                    {
                        <option value="@p.IdPoste">@p.IdPoste — @p.LigneProduction</option>
                    }
                </select>
                <label class="form-label">Opérateur</label>
                <select class="form-select mb-3" asp-for="MatriculeOp">
                    @foreach (var op in Model.Operateurs)
                    {
                        <option value="@op.MatriculeOp">@op.MatriculeOp — @op.NomComplet</option>
                    }
                </select>
                <button id="btnCapturerPoste" type="submit" class="btn btn-sebn w-100">
                    ▶️ Capturer une image
                </button>
            </div>
        </form>

        <div id="posteAlerte"></div>

        @if (Model.Statut == "hors_domaine")
        {
            <div class="alert alert-warning">
                <strong>⚠️ Image hors domaine industriel</strong><br />
                @(!string.IsNullOrWhiteSpace(Model.Message) ? Model.Message : "Cette image ne correspond pas à un poste industriel valide.")
            </div>
        }
        else if (Model.Anomalie != null)
        {
            <div class="alert alert-danger">
                <strong>⚠️ @Model.Anomalie.TypeAnomalie détecté</strong><br />
                Classe : <code>@Model.Anomalie.Classe</code><br />
                Confiance : @((int)(Model.Anomalie.Confiance * 100))%
            </div>
        }
        else if (Model.ImageBase64 != null)
        {
            <div class="alert alert-success">✅ Poste conforme</div>
        }
    </div>
</div>

<hr class="my-4" />

<div class="sebn-header">
    <div>
        <div style="font-size:20px; font-weight:700; color:var(--navy-dark);">Mode démonstration — Image industrielle</div>
        <div style="font-size:13px; color:#6b6b70;">Les échantillons ci-dessous sont issus du dataset industriel du projet. Vous pouvez aussi sélectionner une image depuis ce PC.</div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div id="demoImageZone" class="sebn-kpi text-center">
            <div class="text-muted py-5">Sélectionnez un échantillon industriel ou une image depuis ce PC.</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sebn-kpi mb-3">
            <span class="badge badge-primary mb-2">Mode démonstration — Image industrielle</span>
            <label class="form-label" for="demoFile">Image industrielle depuis ce PC</label>
            <input id="demoFile" class="form-control mb-3" type="file" accept="image/jpeg,image/png,image/webp" />
            <button id="btnAnalyserDemo" type="button" class="btn btn-sebn w-100 mb-3" disabled>🔎 Analyser l’image sélectionnée</button>
        </div>
        <div id="demoAlerte"></div>
    </div>
</div>

<hr class="my-4" />

<div class="sebn-header">
    <div>
        <div style="font-size:20px; font-weight:700; color:var(--navy-dark);">📱 Caméra de cet appareil</div>
        <div style="font-size:13px; color:#6b6b70;">Fonctionne sur PC (webcam) et téléphone (caméra arrière/avant) — capture réelle envoyée à l'IA</div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="sebn-kpi text-center">
            <video id="camVideo" autoplay playsinline style="width:100%; border-radius:10px; display:none;"></video>
            <canvas id="camCanvas" style="display:none;"></canvas>
            <img id="camResultImg" class="img-fluid rounded" style="display:none;" />
            <div id="camPlaceholder" class="text-muted py-5">Cliquez sur « Activer la caméra » pour commencer.</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sebn-kpi mb-3">
            <button id="btnActiverCam" class="btn btn-sebn w-100 mb-2">🎥 Activer la caméra</button>
            <button id="btnCapturerCam" class="btn btn-outline-primary w-100" disabled>📸 Capturer et analyser</button>
        </div>
        <div id="camAlerte"></div>
    </div>
</div>

<script>
(function () {
    const video = document.getElementById('camVideo');
    const canvas = document.getElementById('camCanvas');
    const resultImg = document.getElementById('camResultImg');
    const placeholder = document.getElementById('camPlaceholder');
    const btnActiver = document.getElementById('btnActiverCam');
    const btnCapturer = document.getElementById('btnCapturerCam');
    const btnCapturerPoste = document.getElementById('btnCapturerPoste');
    const posteImageZone = document.getElementById('posteImageZone');
    const posteAlerte = document.getElementById('posteAlerte');
    const alerteZone = document.getElementById('camAlerte');
    const demoFile = document.getElementById('demoFile');
    const btnAnalyserDemo = document.getElementById('btnAnalyserDemo');
    const demoImageZone = document.getElementById('demoImageZone');
    const demoAlerte = document.getElementById('demoAlerte');
    const demoSamples = document.querySelectorAll('.btn-demo-sample');
    const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    let stream = null;
    let signalPerduEnvoye = false;
    let surveillanceIntervalId = null;

    function entitesHtml(value) {
        const element = document.createElement('div');
        element.textContent = value ?? '';
        return element.innerHTML;
    }

    function entetesApi() {
        return { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken || '' };
    }

    function imageBase64Securisee(value) {
        const base64 = String(value || '').replace(/^data:image\/[^;]+;base64,/, '');
        return /^[A-Za-z0-9+/]+={0,2}$/.test(base64) ? base64 : '';
    }

    async function lireReponseJson(rep) {
        const contenu = await rep.text();
        if (!contenu.trim()) {
            throw new Error('Le serveur a retourné une réponse vide (HTTP ' + rep.status + ').');
        }
        try {
            return JSON.parse(contenu);
        } catch (err) {
            throw new Error('Le serveur a retourné une réponse invalide (HTTP ' + rep.status + ').');
        }
    }

    async function fetchAvecTimeout(url, options, dureeMs = 180000) {
        const controleur = new AbortController();
        const timer = setTimeout(() => controleur.abort(), dureeMs);
        try {
            return await fetch(url, { ...options, signal: controleur.signal });
        } finally {
            clearTimeout(timer);
        }
    }

    function idPosteActuel() {
        return document.querySelector('select[name="IdPoste"]')?.value || 'P01';
    }

    function matriculeOpActuel() {
        return document.querySelector('select[name="MatriculeOp"]')?.value || '';
    }

    function messageErreurCamera(err) {
        if (err.name === 'AbortError') {
            return 'Le service IA met plus de temps que prévu à répondre. Attendez quelques secondes puis relancez l’analyse.';
        }
        if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
            return 'Accès à la caméra refusé. Veuillez autoriser la caméra dans votre navigateur.';
        }
        if (err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError') {
            return 'Aucune caméra disponible sur cet appareil.';
        }
        return err.message || 'Impossible d’accéder à la caméra.';
    }

    function preparerCapture() {
        const largeurMax = 640;
        const facteur = Math.min(1, largeurMax / video.videoWidth);
        canvas.width = Math.round(video.videoWidth * facteur);
        canvas.height = Math.round(video.videoHeight * facteur);
        canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
        return canvas.toDataURL('image/jpeg', 0.8);
    }

    function afficherResultat(zone, alerte, data) {
        zone.innerHTML = '<img src="data:image/jpeg;base64,' + imageBase64Securisee(data.imageBase64) + '" class="img-fluid rounded" alt="Image industrielle analysée" />';
        if (data.status === 'hors_domaine') {
            alerte.innerHTML = '<div class="alert alert-warning"><strong>⚠️ Image hors domaine industriel</strong><br>' + entitesHtml(data.message || 'Cette image ne correspond pas à un poste industriel valide.') + '</div>';
            return;
        }
        alerte.innerHTML = data.anomalie
            ? '<div class="alert alert-danger"><strong>⚠️ ' + entitesHtml(data.anomalie.type) + ' détecté</strong><br>Classe : <code>' + entitesHtml(data.anomalie.classe) + '</code><br>Confiance : ' + Math.round(data.anomalie.confiance * 100) + '%</div>'
            : '<div class="alert alert-success">✅ Poste conforme</div>';
    }

    async function analyserDemonstration(imageBase64, bouton) {
        bouton.disabled = true;
        const texteInitial = bouton.textContent;
        bouton.textContent = '⏳ Analyse en cours...';
        demoAlerte.innerHTML = '';
        try {
            const rep = await fetchAvecTimeout('/api/detect-photo', {
                method: 'POST',
                headers: entetesApi(),
                body: JSON.stringify({ imageBase64: imageBase64, idPoste: idPosteActuel(), matriculeOp: matriculeOpActuel() })
            });
            const data = await lireReponseJson(rep);
            if (!rep.ok || data.erreur) {
                throw new Error(data.erreur || 'Analyse impossible.');
            }
            afficherResultat(demoImageZone, demoAlerte, data);
        } catch (err) {
            demoAlerte.innerHTML = '<div class="alert alert-danger">' + entitesHtml(messageErreurCamera(err)) + '</div>';
        } finally {
            bouton.disabled = false;
            bouton.textContent = texteInitial;
        }
    }

    function lireImageCommeBase64(fichier) {
        return new Promise((resolve, reject) => {
            const lecteur = new FileReader();
            lecteur.onload = () => resolve(lecteur.result);
            lecteur.onerror = () => reject(new Error('Lecture de l’image impossible.'));
            lecteur.readAsDataURL(fichier);
        });
    }

    demoFile.addEventListener('change', () => {
        btnAnalyserDemo.disabled = !demoFile.files?.length;
        demoAlerte.innerHTML = '';
    });

    btnAnalyserDemo.addEventListener('click', async () => {
        if (!demoFile.files?.length) return;
        try {
            await analyserDemonstration(await lireImageCommeBase64(demoFile.files[0]), btnAnalyserDemo);
        } catch (err) {
            demoAlerte.innerHTML = '<div class="alert alert-danger">' + entitesHtml(messageErreurCamera(err)) + '</div>';
        }
    });

    demoSamples.forEach((bouton) => {
        bouton.addEventListener('click', async () => {
            try {
                const rep = await fetch(bouton.dataset.demoUrl);
                if (!rep.ok) throw new Error('Échantillon industriel indisponible.');
                const fichier = await rep.blob();
                await analyserDemonstration(await lireImageCommeBase64(fichier), bouton);
            } catch (err) {
                demoAlerte.innerHTML = '<div class="alert alert-danger">' + entitesHtml(messageErreurCamera(err)) + '</div>';
            }
        });
    });

    async function signalerPerteFlux() {
        if (signalPerduEnvoye) return;
        signalPerduEnvoye = true;
        try {
            await fetch('/api/camera-signal-perdu', {
                method: 'POST',
                headers: entetesApi(),
                body: JSON.stringify({ idPoste: idPosteActuel() })
            });
        } catch (e) { /* silencieux : notification best-effort */ }
        alerteZone.innerHTML = '<div class="alert alert-warning">📡 Perte du flux caméra détectée — le Superviseur PIT a été notifié.</div>';
        btnCapturer.disabled = true;
    }

    function demarrerSurveillanceFlux(track) {
        signalPerduEnvoye = false;
        // Cas 1 : le navigateur signale l'arrêt réel du flux (déconnexion, permission révoquée...)
        track.addEventListener('ended', signalerPerteFlux);

        // Cas 2 : le flux est toujours "actif" côté navigateur mais ne délivre plus
        // d'image (timeout) — vérifié toutes les 2s, seuil de 10s sans image valide.
        clearInterval(surveillanceIntervalId);
        surveillanceIntervalId = setInterval(() => {
            if (track.readyState !== 'live' || video.readyState < 2) {
                signalerPerteFlux();
            }
        }, @Model.TimeoutPerteCameraSecondes * 1000);
    }

    btnCapturerPoste.addEventListener('click', async (event) => {
        event.preventDefault();
        btnCapturerPoste.disabled = true;
        btnCapturerPoste.textContent = '⏳ Analyse en cours...';

        try {
            if (!stream) {
                stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: 'environment' }
                });
                video.srcObject = stream;
                await video.play();
                demarrerSurveillanceFlux(stream.getVideoTracks()[0]);
            }

            if (!video.videoWidth || !video.videoHeight) {
                await new Promise(resolve => video.addEventListener('loadedmetadata', resolve, { once: true }));
            }

            const imageBase64 = preparerCapture();
            const rep = await fetchAvecTimeout('/api/detect-photo', {
                method: 'POST',
                headers: entetesApi(),
                body: JSON.stringify({ imageBase64: imageBase64, idPoste: idPosteActuel(), matriculeOp: matriculeOpActuel() })
            });
            const data = await lireReponseJson(rep);

            if (!rep.ok || data.erreur) {
                throw new Error(data.erreur || 'Analyse impossible.');
            }

            posteImageZone.innerHTML = '<img src="data:image/jpeg;base64,' + imageBase64Securisee(data.imageBase64) + '" class="img-fluid rounded" alt="Image analysée" />';
            if (data.status === 'hors_domaine') {
                posteAlerte.innerHTML = '<div class="alert alert-warning"><strong>⚠️ Image hors domaine industriel</strong><br>' + entitesHtml(data.message || 'Cette image ne correspond pas à un poste industriel valide.') + '</div>';
            } else {
                posteAlerte.innerHTML = data.anomalie
                    ? '<div class="alert alert-danger"><strong>⚠️ ' + entitesHtml(data.anomalie.type) + ' détecté</strong><br>Classe : <code>' + entitesHtml(data.anomalie.classe) + '</code><br>Confiance : ' + Math.round(data.anomalie.confiance * 100) + '%</div>'
                    : '<div class="alert alert-success">✅ Poste conforme</div>';
            }
        } catch (err) {
            posteAlerte.innerHTML = '<div class="alert alert-danger">' + entitesHtml(messageErreurCamera(err)) + '</div>';
        }

        btnCapturerPoste.disabled = false;
        btnCapturerPoste.textContent = '▶️ Capturer une image';
    });

    btnActiver.addEventListener('click', async () => {
        try {
            stream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: 'environment' }
            });
            video.srcObject = stream;
            video.style.display = 'block';
            resultImg.style.display = 'none';
            placeholder.style.display = 'none';
            btnCapturer.disabled = false;
            demarrerSurveillanceFlux(stream.getVideoTracks()[0]);
        } catch (err) {
            alerteZone.innerHTML = '<div class="alert alert-danger">' + entitesHtml(messageErreurCamera(err)) + '</div>';
        }
    });

    btnCapturer.addEventListener('click', async () => {
        if (!video.videoWidth || !video.videoHeight) {
            alerteZone.innerHTML = '<div class="alert alert-warning">La caméra n’est pas encore prête. Réessayez dans un instant.</div>';
            return;
        }
        const imageBase64 = preparerCapture();

        btnCapturer.disabled = true;
        btnCapturer.textContent = '⏳ Analyse en cours...';

        try {
            const idPoste = document.querySelector('select[name="IdPoste"]')?.value || 'P01';
            const rep = await fetchAvecTimeout('/api/detect-photo', {
                method: 'POST',
                headers: entetesApi(),
                body: JSON.stringify({ imageBase64: imageBase64, idPoste: idPoste, matriculeOp: matriculeOpActuel() })
            });
            const data = await lireReponseJson(rep);

            if (data.erreur) {
                alerteZone.innerHTML = '<div class="alert alert-warning">' + entitesHtml(data.erreur) + '</div>';
            } else {
                resultImg.src = 'data:image/jpeg;base64,' + imageBase64Securisee(data.imageBase64);
                resultImg.style.display = 'block';
                video.style.display = 'none';

                if (data.status === 'hors_domaine') {
                    alerteZone.innerHTML = '<div class="alert alert-warning"><strong>⚠️ Image hors domaine industriel</strong><br>' +
                        entitesHtml(data.message || 'Cette image ne correspond pas à un poste industriel valide.') + '</div>';
                } else if (data.anomalie) {
                    alerteZone.innerHTML = '<div class="alert alert-danger"><strong>⚠️ ' +
                        entitesHtml(data.anomalie.type) + ' détecté</strong><br>Classe : <code>' +
                        entitesHtml(data.anomalie.classe) + '</code><br>Confiance : ' +
                        Math.round(data.anomalie.confiance * 100) + '%</div>';
                } else {
                    alerteZone.innerHTML = '<div class="alert alert-success">✅ Poste conforme</div>';
                }
            }
        } catch (err) {
            alerteZone.innerHTML = '<div class="alert alert-danger">Erreur réseau : ' + entitesHtml(err.message) + '</div>';
        }

        btnCapturer.disabled = false;
        btnCapturer.textContent = '📸 Capturer et analyser';
    });
})();
</script>
